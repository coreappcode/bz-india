# ============================================================
# Frontend build environment — PUBLIC KEYS
# ============================================================
# These are embedded into frontend JS at build time and are visible in browser.

# Supabase (public client config)
VITE_SUPABASE_URL=https://aiiefgjfftmerayihpbv.supabase.co
# Preferred public key name for Amplify and local builds:
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key
# Legacy alternatives are supported when SUPABASE_PUBLISHABLE_KEY is not set:
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key

# Exchange Rate API (server-side only)
# The API key is stored as a Supabase secret (EXCHANGERATE_API_KEY) and
# fetched via the exchange-rates edge function. Frontend never sees the key.
# Set it with: supabase secrets set EXCHANGERATE_API_KEY=your-key
# If not set, the edge function falls back to the free public API automatically.
# VITE_EXCHANGERATE_API_KEY is no longer needed — DO NOT add it.

# Domain & Environment
# Set VITE_PUBLIC_APP_URL to https://www.bzead.in for the India build or the BZEAD.MV origin for MV; required for production builds.
VITE_DOMAIN=
VITE_PUBLIC_APP_URL=
VITE_ENVIRONMENT=production

# Auth Email Infrastructure
# Supabase Auth uses Custom SMTP (Resend) configured in Supabase dashboard.
# Do not hardcode SMTP credentials in frontend env files.

# Stripe — REQUIRED for payments
# Frontend (public, safe to expose)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# OneSignal — Push Notifications (replaces Firebase Cloud Messaging)
# App ID is public (safe to embed in frontend). REST API Key MUST stay in
# Supabase secrets only — never expose in VITE_* vars.
VITE_ONESIGNAL_APP_ID=02f9a15b-ca1c-4ab2-8404-8a8cdb9afef9

# Google AdSense — Display ads (OPTIONAL)
# Leave both UNSET until AdSense approves your site, otherwise no AdSense
# script is loaded and no ad slots are rendered (zero overhead).
# - VITE_ADSENSE_CLIENT: your publisher ID (format: ca-pub-xxxxxxxxxxxxxxxx)
# - VITE_ADSENSE_SLOT_HOME_FOOTER: ad unit ID for the home page above-footer
#   slot (only renders when no internal video ads are configured).
# VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# VITE_ADSENSE_SLOT_HOME_FOOTER=1234567890

# ============================================================
# SERVER-ONLY SECRETS (DO NOT ADD AS VITE_* IN FRONTEND)
# ============================================================
# Keep these in secure server environments only (Supabase secrets / backend runtime).
# For static frontend hosting, keep these in trusted server environments instead.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# SUPABASE_SERVICE_ROLE=your-service-role-key

# Shiprocket (for Supabase Edge Functions: shiprocket-rate, shiprocket-ops)
# India-origin shipments — domestic India and India-to-international
# SHIPROCKET_EMAIL=your-shiprocket-email
# SHIPROCKET_PASSWORD=your-shiprocket-password
# SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in
# Dedicated backend tables used by Shiprocket flow:
# - public.shiprocket_shipments
# - public.shiprocket_operation_logs
# - public.shiprocket_tracking_events
# - SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# Shippo (for Supabase Edge Functions: shippo-ops, shippo-rate, shippo-webhook)
# UK-origin shipments — both domestic UK and UK-to-international
# SHIPPO_API_TOKEN=shippo_test_your-shippo-api-token
# SHIPPO_WEBHOOK_SECRET=your-shippo-webhook-signing-secret
# Dedicated backend tables used by Shippo flow:
# - public.shippo_shipments
# - public.shippo_operation_logs
# - public.shippo_tracking_events
# - public.shippo_webhook_events

# ============================================================
# AWS BEDROCK (AI — server-side only, never expose as VITE_*)
# ============================================================
# Long-term bearer token from AWS Bedrock Console > API keys
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
AWS_REGION=us-east-1