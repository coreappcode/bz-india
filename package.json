{
  "name": "beauzead-ecommerce",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env VITE_MARKET=IN vite",
    "dev:india": "cross-env VITE_MARKET=IN vite",
    "dev:maldives": "cross-env VITE_MARKET=MV vite",
    "build": "npm run build:buyer:india",
    "build:buyer": "npm run build:buyer:india",
    "build:buyer:maldives": "tsc -b && cross-env VITE_MARKET=MV vite build --outDir dist-buyer --emptyOutDir && cross-env VITE_MARKET=MV node scripts/generate-share-pages.mjs --buyer",
    "build:buyer:india": "tsc -b && cross-env VITE_MARKET=IN vite build --outDir dist-buyer-in --emptyOutDir && cross-env VITE_MARKET=IN node scripts/generate-share-pages.mjs --buyer",
    "build:india": "npm run build:buyer:india",
    "build:maldives": "npm run build:buyer:maldives",
    "build:share-pages": "node scripts/generate-share-pages.mjs",
    "generate:bulk-template": "node scripts/generate-bulk-product-template.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/dialog": "^8.0.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@supabase/supabase-js": "^2.95.3",
    "@types/leaflet": "^1.9.21",
    "jspdf": "^4.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "onesignal-cordova-plugin": "^5.2.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "react-onesignal": "^3.2.3",
    "react-router-dom": "^7.18.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "exceljs": "^4.4.0",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.6",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
